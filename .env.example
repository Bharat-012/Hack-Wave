# PatchMyCity Environment Configuration Example
# Copy this file to .env and configure your secrets

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google Gemini API
# If left empty, PatchMyCity runs seamlessly in transparent Demo Mode with labeled mock outputs
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase PostgreSQL Database (Optional for purely offline memory demo, required for full persistence)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
